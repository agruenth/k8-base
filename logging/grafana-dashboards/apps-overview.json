    {
      "title": "Error Rate (all services)",
      "description": "Lines containing 'error' or 'ERROR' per minute, grouped by service",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 50,
            "stacking": { "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (app) (count_over_time({namespace=\"apps\", app=~\"$service\"} |~ \"(?i)error\" [1m]))",
          "legendFormat": "{{ app }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Live Log Stream",
      "description": "Tail logs for the selected service",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 35 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{namespace=\"apps\", app=~\"$service\"}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["apps", "loki", "overview"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "label": "Service",
        "description": "Filter by application service name",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "options": [
          { "selected": true,  "text": "All",            "value": ".*" },
          { "selected": false, "text": "checkmate",      "value": "checkmate" },
          { "selected": false, "text": "wandermind",     "value": "wandermind" },
          { "selected": false, "text": "eden",           "value": "eden" },
          { "selected": false, "text": "req-helper",     "value": "req-helper" },
          { "selected": false, "text": "master-agent",   "value": "master-agent" },
          { "selected": false, "text": "ai-tooling",     "value": "ai-tooling" },
          { "selected": false, "text": "munchkin-td",    "value": "munchkin-td" },
          { "selected": false, "text": "citizen-dev",    "value": "citizen-dev" },
          { "selected": false, "text": "admin-ui",       "value": "admin-ui" }
        ],
        "query": "",
        "includeAll": false,
        "multi": false
      }
    ]
  },
