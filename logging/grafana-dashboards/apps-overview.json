{
  "annotations": {
    "list": []
  },
  "description": "Overview of application logs collected via Loki - volume, error rates, and per-service filtering.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Service Filter",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "title": "Total Log Volume (all services)",
      "description": "Log lines per minute across all services",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 30,
            "stacking": { "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum by (app) (count_over_time({namespace=\"apps\", app=~\"$service\"} [1m]))",
          "legendFormat": "{{ app }}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Log Volume - checkmate",
      "type": "timeseries",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "color": { "fixedColor": "blue", "mode": "fixed" }, "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(count_over_time({namespace=\"apps\", app=\"checkmate\"} [1m]))",
          "legendFormat": "checkmate",
          "refId": "A"
